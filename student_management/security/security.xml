<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Student Management Category -->
    <record id="module_category_student_management"
            model="ir.module.category">
        <field name="name">Student Management</field>
        <field name="sequence">30</field>
    </record>

    <!-- Student Management Administrator Group -->
    <record id="group_student_management_admin"
            model="res.groups">

        <field name="name">
            Student Management Administrator
        </field>

        <field name="category_id"
               ref="module_category_student_management"/>

        <field name="implied_ids"
               eval="[(4, ref('base.group_system'))]"/>

    </record>

        <!-- Teacher Group -->
    <record id="group_student_management_teacher"
            model="res.groups">

        <field name="name">Student Management Teacher</field>

        <field name="category_id"
               ref="module_category_student_management"/>

        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>

    </record>

    <!-- Accountant group -->
    <record id="group_student_management_accountant"
            model="res.groups">
        <field name="name">Student Management Accountant</field>
        <field name="category_id"
                ref="module_category_student_management"/>
        
        <field name="implied_ids"
                eval="[(4,ref('base.group_user'))]"/>
    </record>


    

</odoo>