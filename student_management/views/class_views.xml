<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Class Tree View -->
    <record id="view_school_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <tree string="Classes">
                <field name="class_code"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="subject_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>


    <!-- Class Form View -->
    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Class Information">
                            <field name="class_code"/>
                            <field name="capacity"/>
                            <field name="teacher_user_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>

                        </group>

                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Subjects -->
                        <page string="Subjects">
                            <field name="subject_ids"
                                widget="many2many_tags"/>
                        </page>

                        <!-- Enrolled Students -->
                        <page string="Students">
                            <field name="student_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="fee"/>
                                    <field name="payment_status"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Weekly Timetable -->
                        <page string="Timetable">
                            <field name="timetable_ids">
                                <tree>

                                    <field name="name"/>
                                    <field name="semester_id"/>
                                    <field name="day_of_week"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room"/>
                                    <field name="state"/>

                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- Class Search View -->
    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search string="Search Classes">

                <field name="name"/>
                <field name="class_code"/>

                <separator/>
                <filter name="active"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_subject"
                            string="Subject"
                            context="{'group_by': 'subject_ids'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- Class Action -->
    <record id="action_school_class"
            model="ir.actions.act_window">

        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">tree,form</field>

        <field name="search_view_id"
               ref="view_school_class_search"/>

    </record>

</odoo>