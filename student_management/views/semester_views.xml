<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Semester Tree View -->
    <record id="view_school_semester_tree" model="ir.ui.view">
        <field name="name">school.semester.tree</field>
        <field name="model">school.semester</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Semester Form View -->
    <record id="view_school_semester_form" model="ir.ui.view">
        <field name="name">school.semester.form</field>
        <field name="model">school.semester</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,completed"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Semester Action -->
    <record id="action_school_semester" model="ir.actions.act_window">
        <field name="name">Semesters</field>
        <field name="res_model">school.semester</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>