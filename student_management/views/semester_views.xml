<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Semester Tree View -->
    <record id="view_school_semester_tree" model="ir.ui.view">
        <field name="name">school.semester.tree</field>
        <field name="model">school.semester</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'completed'"/>
            </tree>
        </field>
    </record>

    <!-- Semester Form View -->
    <record id="view_school_semester_form" model="ir.ui.view">
        <field name="name">school.semester.form</field>
        <field name="model">school.semester</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,completed"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active" invisible="1"/>

                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Semester Search View -->
<record id="view_school_semester_search" model="ir.ui.view">
    <field name="name">school.semester.search</field>
    <field name="model">school.semester</field>
    <field name="arch" type="xml">
        <search string="Search Semester">

            <field name="name"/>
            <field name="start_date"/>
            <field name="end_date"/>

            <separator/>

            <filter name="active"
                    string="Active"
                    domain="[('active', '=', True)]"/>

            <filter name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"/>

            <filter name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"/>

            <filter name="in_progress"
                    string="Active"
                    domain="[('state', '=', 'active')]"/>

            <filter name="completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"/>

            <group expand="0" string="Group By">
                <filter name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                <filter name="group_by_start_date"
                        string="Start Date"
                        context="{'group_by': 'start_date'}"/>
            </group>

        </search>
    </field>
</record>

    <!-- Semester Action -->
    <record id="action_school_semester" model="ir.actions.act_window">
        <field name="name">Semesters</field>
        <field name="res_model">school.semester</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>