<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Subject Tree View -->
    <record id="view_school_subject_tree" model="ir.ui.view">
        <field name="name">school.subject.tree</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <tree string="Subjects">

                <field name="subject_code"/>
                <field name="name"/>
                <field name="teacher_ids"
                       widget="many2many_tags"/>
                <field name="fee"/>
                <field name="class_ids"
                       widget="many2many_tags"/>

            </tree>
        </field>
    </record>


    <!-- Subject Form View -->
    <record id="view_school_subject_form" model="ir.ui.view">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Subject Information">
                            <field name="subject_code"/>
                            <field name="fee"/>
                            <field name="currency_id"/>
                            <field name="active" invisible="1"/>
                            
                        </group>

                    </group>

                    <notebook>

                        <page string="Teachers">

                            <field name="teacher_ids"
                                widget="many2many_tags"/>

                        </page>

                        <page string="Classes">

                            <field name="class_ids"
                                widget="many2many_tags"/>

                        </page>

                        <page string="Timetable">

                            <field name="timetable_ids">

                                <tree>

                                    <field name="name"/>
                                    <field name="class_id"/>
                                    <field name="teacher_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="state"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- Subject Search View -->
    <record id="view_school_subject_search" model="ir.ui.view">
        <field name="name">school.subject.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">

                <field name="name"/>
                <field name="subject_code"/>

                <separator/>

                <filter name="active"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">

                    <filter name="group_by_teacher"
                            string="Teacher"
                            context="{'group_by': 'teacher_ids'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- Subject Action -->
    <record id="action_school_subject"
            model="ir.actions.act_window">

        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="view_school_subject_search"/>

    </record>


</odoo>