<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Student Tree View -->
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <tree string="Student">

                <field name="student_code"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="registration_date"/>

            </tree>
        </field>
    </record>


    <!-- Student Form View -->
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Student Name"
                                   />
                        </h1>
                    </div>
                    <div>
                        <field name="image" widget="image" class="oe_avatar"  options="{'size': [100, 100]}"/>
                    </div>
                    <group>

                        <group string="Personal Information">
                            
                            <field name="student_code"/>
                            <field name="gender"/>
                            <field name="class_id"/>
                            <field name="date_of_birth"/>
                            <field name="registration_date"/>
                            <field name="active" invisible="1"/>
                            

                        </group>

                        <group string="Contact Information">
                            
                            <field name="phone" widget="phone" default_focus="1"/>
                            <field name="email" widget="email"/>
                            <field name="address" widget="url"/>

                        </group>

                    </group>

                    <notebook>


                        <page string="Enrollments"
                                groups="student_management.group_student_management_admin,student_management.group_student_management_accountant"
                                    >

                            <field name="enrollment_ids">

                                <tree editable="bottom">

                                    <field name="name"/>
                                    <field name="class_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="fee"/>
                                    <field name="currency_id"
                                           invisible="1"/>
                                    <field name="payment_status"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- Student Search View -->
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">

                <field name="name"/>
                <field name="student_code"/>
                <field name="phone"/>
                <field name="email"/>

                <separator/>

                <filter name="male"
                        string="Male"
                        domain="[('gender', '=', 'male')]"/>

                <filter name="female"
                        string="Female"
                        domain="[('gender', '=', 'female')]"/>

                <separator/>

                <filter name="active_students"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="inactive_students"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_gender"
                            string="Gender"
                            context="{'group_by': 'gender'}"/>

                    <filter name="group_by_registration"
                            string="Registration Date"
                            context="{'group_by': 'registration_date'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- Student Window Action -->
    <record id="action_school_student" model="ir.actions.act_window">

        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="view_school_student_search"/>

        <field name="context">
            {'search_default_active_students': 1}
        </field>

    </record>


</odoo>