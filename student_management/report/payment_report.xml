<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Payment Report Action -->
    <record id="action_report_student_payment" model="ir.actions.report">
        <field name="name">Student Payment Report</field>
        <field name="model">school.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_payment</field>
        <field name="report_file">student_management.report_student_payment</field>
        <field name="binding_model_id" ref="model_school_payment"/>
        <field name="groups_id"
       eval="[(4, ref('student_management.group_student_management_admin')),
              (4, ref('student_management.group_student_management_accountant'))]"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Payment Report - %s' % (object.name)</field>
    </record>

    <!-- Payment Report Template -->
    <template id="report_student_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <div class="page">

                        <h2 class="text-center">
                            Student Payment Report
                        </h2>

                        <br/>

                        <table class="table table-bordered">

                            <tr>
                                <th>Payment Reference</th>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Student Name</th>
                                <td>
                                    <span t-field="o.student_id.name"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Student ID</th>
                                <td>
                                    <span t-field="o.student_id.student_code"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Enrollment</th>
                                <td>
                                    <span t-field="o.enrollment_id.name"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Payment Date</th>
                                <td>
                                    <span t-field="o.payment_date"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Payment Method</th>
                                <td>
                                    <span t-field="o.payment_method"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Payment Amount</th>
                                <td>
                                    <span t-field="o.amount"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Payment Status</th>
                                <td>
                                    <span t-field="o.state"/>
                                </td>
                            </tr>

                        </table>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo> 